# Environment Configuration

# GitHub Token (needs workflow dispatch permissions)
GITHUB_TOKEN=your_github_token_here

# X25519 Private Key for signing workflow requests (hex format)
# Generate with: openssl rand -hex 32
X25519_PRIVATE_KEY=your_private_key_hex

# Database Path
DB_PATH=./db/xp-reports.db

# SMTP Configuration for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@ubq.fi

# Admin API Key for stats endpoint
ADMIN_API_KEY=your_random_api_key_here

# Server Port
PORT=3000
